# ── AI Insights (optional) ──────────────────────────────────────────────────
# TerraComrad runs fully locally with NO network calls by default. The optional
# "AI Insights" panel adds ONE multimodal call to a free model (Google Gemini
# Flash) that narrates the AOI profile. It stays OFF until you set a key below.
#
# Get a free Gemini API key: https://aistudio.google.com/apikey
# Copy this file to .env and paste your key.

INSIGHTS_API_KEY=

# Optional overrides (sensible defaults shown):
# INSIGHTS_PROVIDER=gemini
# INSIGHTS_MODEL=gemini-2.5-flash
# INSIGHTS_ENABLED=true          # auto-enabled when a key is present; set false to force off
# INSIGHTS_MAX_IMAGE_MB=4        # reject composite images larger than this
